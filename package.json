{
  "name": "shaadivibe-monorepo",
  "version": "1.0.0",
  "description": "ShaadiVibe — Premium Digital Indian Wedding Invitation Platform (Monorepo)",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=@shaadivibe/client",
    "dev:server": "npm run dev --workspace=@shaadivibe/server",
    "dev:all": "concurrently -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev": "npm run dev:all",
    "build": "npm run build --workspace=@shaadivibe/client",
    "test:client": "npm run test --workspace=@shaadivibe/client",
    "test:server": "node --test server/tests/api.test.js",
    "test": "npm run test:client && npm run test:server",
    "seed": "npm run seed --workspace=@shaadivibe/server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
